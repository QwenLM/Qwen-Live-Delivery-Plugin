{
  "name": "ld",
  "version": "0.1.0",
  "mcpServers": {
    "live-delivery": {
      "command": "node",
      "args": ["${extensionPath}/dist/server.mjs", "--qwen-code"],
      "cwd": "${extensionPath}",
      "alwaysLoadTools": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --qwen-code",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --qwen-code",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --qwen-code",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --qwen-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" --qwen-code",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
