{
  "name": "qwen-live-delivery-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:codex": "node test/workbench-native.mjs",
    "test:qwen": "node test/qwen-native.mjs",
    "verify": "npm run build && npm run typecheck && npm test && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "package": "npm run build && npm run check:release && node scripts/package.mjs",
    "format": "prettier --write .. --config .prettierrc.json --ignore-path .prettierignore",
    "format:check": "prettier --check .. --config .prettierrc.json --ignore-path .prettierignore"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "prettier": "3.6.2",
    "typescript": "^5.6.0"
  },
  "files": [
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "qwen-extension.json",
    "hooks/",
    "skills/",
    "dist/",
    "LICENSE",
    "install.sh"
  ],
  "description": "Codex adapter for Qwen Live Delivery Plugin: chat-driven iteration, usable version snapshots, and a local preview workbench."
}
